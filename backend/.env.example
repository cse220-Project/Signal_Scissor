# Export these variables before starting Uvicorn. No dotenv loader is required.
NOISE_MAX_UPLOAD_MB=60
NOISE_MAX_DURATION_SECONDS=300
NOISE_PROCESS_TIMEOUT_SECONDS=120
NOISE_RETENTION_SECONDS=3600
NOISE_CLEANUP_INTERVAL_SECONDS=300
NOISE_MAX_CONCURRENT=2
# Optional private parent directory; default: system temp/signal-scissors-noise
# NOISE_STORAGE_DIR=/var/lib/signal-scissors
# Executable names on PATH or absolute trusted executable paths:
NOISE_FFMPEG_PATH=ffmpeg
NOISE_FFPROBE_PATH=ffprobe
